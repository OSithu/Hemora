# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=hemora-backend.azurewebsites.net

# Database (Azure PostgreSQL)
DB_NAME=hemora
DB_USER=hemora_admin
DB_PASSWORD=your-db-password
DB_HOST=hemora-db.postgres.database.azure.com
DB_PORT=5432

# CORS (your frontend URL)
CORS_ALLOWED_ORIGINS=https://your-frontend.azurestaticapps.net

# Tesseract (auto-detected on Linux)
# TESSERACT_CMD=/usr/bin/tesseract

# SSL (set to False if behind Azure reverse proxy handling SSL)
# SECURE_SSL_REDIRECT=True
